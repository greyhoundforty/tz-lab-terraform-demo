# Copy to terraform.tfvars. That file is gitignored.
# ibmcloud_api_key can be omitted when IC_API_KEY is set in the environment.
#
# Terraform reads the PowerVS public key from ~/.ssh/pvs-lab.pub.
# Leave vpc_name unset to create the workspace, networks, and key without a VPC.

region         = "us-south"
pi_zone        = "dal12"
powervs_cidr   = "192.168.100.0/24"

# Leave empty for the first apply. Set it after image list-catalog.
aix_image_name = ""
