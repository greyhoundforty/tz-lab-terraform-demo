#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - unzip

write_files:
  - path: /etc/profile.d/lab-tools.sh
    permissions: "0644"
    content: |
      export IBMCLOUD_HOME=/opt/ibmcloud
  - path: /usr/local/sbin/install-lab-tools.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euxo pipefail
      export DEBIAN_FRONTEND=noninteractive
      export IBMCLOUD_HOME=/opt/ibmcloud

      apt-get update
      apt-get install -y ansible || apt-get install -y ansible-core

      terraform_version="1.14.5"

      curl -fsSL -o /tmp/terraform.zip \
        "https://releases.hashicorp.com/terraform/${terraform_version}/terraform_${terraform_version}_linux_amd64.zip"
      unzip -o /tmp/terraform.zip -d /usr/local/bin
      chmod 0755 /usr/local/bin/terraform
      rm -f /tmp/terraform.zip

      curl -fsSL https://clis.cloud.ibm.com/install/linux | sh
      install -d -o root -g root -m 0755 /opt/ibmcloud
      ibmcloud config --check-version=false
      ibmcloud plugin install power-iaas -f

      {
        echo "terraform: $(/usr/local/bin/terraform version)"
        echo "ansible: $(ansible --version | head -n 1)"
        echo "ibmcloud: $(ibmcloud version)"
        ibmcloud plugin list
      } > /var/log/lab-tools-install.log 2>&1

runcmd:
  - /usr/local/sbin/install-lab-tools.sh
